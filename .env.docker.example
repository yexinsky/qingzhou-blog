# QzBlog Docker Compose 环境变量样例
#
# 用法：cp .env.docker.example .env，填好标注【必填】的项，然后
#       docker compose up -d --build
#
# 注意：等号两侧不要留空格；值不要用引号包起来（compose 会把引号当成值的一部分）。

# ==================== 访问地址与端口 ====================
# 【必填】改成你实际访问博客的地址（含端口），末尾不要带斜杠。
# 填错的后果：登录后会跳回错误地址，后台进不去。
SITE_URL=http://192.168.5.2:8080
NEXTAUTH_URL=http://192.168.5.2:8080

# 宿主机 Web 端口。飞牛自带服务（8000/8001）与其他容器常占用的端口请避开；
# 冲突时只改这里即可，容器内部固定用 3000。
WEB_PORT=8080

# MySQL 数据目录的宿主路径（数据库文件）。飞牛上建议指向存储卷的绝对路径，
# 便于在文件管理器里直接看到，例如：DATA_DIR=/vol1/1000/qzblog
# 不要放在 SMB/NFS 网络共享或 exFAT/NTFS 外置盘上：InnoDB 需要 POSIX 权限与文件锁。
DATA_DIR=./data

# 附件与备份默认存在 Docker 命名卷（qzblog_uploads / qzblog_backups）里，
# 无需关心权限。想把它们放进自己的共享目录，见 docker-compose.yml 中 app 的 volumes 注释。

# 容器时区。页面上的日期按它渲染，建议与读者所在时区一致。
TZ=Asia/Shanghai

# 改用绑定挂载存放附件时，运行用户的 uid/gid 必须与目标目录属主一致
# （飞牛共享目录通常为 1000，可用 SSH 执行 ls -ln <目录> 查看第三列）
PUID=1000
PGID=1000

# 构建镜像时拉取 npm 依赖的镜像源。国内网络可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

# ==================== 安全密钥 ====================
# 【必填】至少 32 位随机字符。生成：openssl rand -base64 32
NEXTAUTH_SECRET=

# 可选：匿名访客标识的 HMAC 密钥（同样要 >= 32 位）。
# 留空则回退使用 NEXTAUTH_SECRET；如果填写，短于 32 位会导致请求报错。
ANONYMOUS_ID_SECRET=

# ==================== 管理员账号 ====================
# 容器首次启动时，若数据库 users 表为空，会按这个用户名自动建一条 admin 记录
# （已有数据的环境不会被改动）。用户名会被转成小写后与库中记录比对。
ADMIN_USERNAME=admin
# 可选：管理员邮箱，默认 <用户名>@localhost
# ADMIN_EMAIL=
# 【必填】请用长且唯一的密码（只存在 .env 里，不入库）
ADMIN_PASSWORD=

# ==================== 数据库 ====================
# 仅在 Docker 内部网络使用，不需要对外暴露；密码建议只用字母数字，
# 避免 @ : / ? # 等 URL 保留字符破坏 DATABASE_URL。
MYSQL_DATABASE=qzblog
MYSQL_USER=qzblog
# 【必填】
MYSQL_PASSWORD=
# 【必填】
MYSQL_ROOT_PASSWORD=

# ==================== 限流 ====================
# memory：计数保存在应用进程内存中，适用于单实例部署（默认）。
# 需要多副本共享计数时，改为填 Upstash 的两个变量（此时 memory 会被忽略）。
RATE_LIMIT_BACKEND=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ==================== HTTPS ====================
# 明文 HTTP（内网 IP 直连）必须保持 false。
# 置为 true 时响应头会带 upgrade-insecure-requests，浏览器会把同源静态资源也改写成
# https，而没有 HTTPS 监听时会直接导致页面丢样式/脚本。
# 真正用上 HTTPS 后再改为 true，并重新构建镜像：docker compose up -d --build
ENFORCE_HTTPS=false

# 由反向代理覆写 X-Real-IP / X-Forwarded-For 时填写（例如 x-real-ip），
# 直连（默认）请留空：留空时限流按“未知来源”统一计数。
TRUSTED_PROXY_IP_HEADER=

# ==================== GitHub 登录（可选） ====================
ENABLE_GITHUB_AUTH=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==================== 附件存储 ====================
# local：存容器内 /app/uploads（即 DATA_DIR/uploads），同源访问，默认
# s3：存 MinIO，需同时启用 minio profile 并填写下方变量
ATTACHMENTS_STORAGE=local

# 额外图片白名单（逗号分隔，填写 origin，例如 http://192.168.5.2:9000）。
# 附件存 MinIO 且用其它地址访问图片时必填，改完需重新构建镜像。
# EXTRA_IMAGE_HOSTS=

# ==================== 可选：MinIO（docker compose --profile minio up -d） ====================
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# S3_ENDPOINT=http://minio:9000
# 浏览器访问图片用的地址（同时作为镜像构建期的图片白名单来源）
# S3_PUBLIC_URL=http://192.168.5.2:9000/qzblog
# S3_BUCKET_NAME=qzblog
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ==================== 高级项（一般不用改） ====================
# 启动时等待数据库的最长毫秒数，超时则容器退出并打印原因
# DB_WAIT_TIMEOUT_MS=120000
# 设为 false 可跳过启动时的自动迁移（多副本部署或手动维护结构时使用）
# RUN_MIGRATIONS=true
