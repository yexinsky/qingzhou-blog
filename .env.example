# Database：两种等价写法，DATABASE_URL 优先；只给 MYSQL_* 时应用会自行拼装连接串
# （见 src/lib/database-url.ts，密码会自动 URL 编码）。用 Docker Compose 部署时只需
# 这组 MYSQL_*，密码写一处即可，配置模板见 .env.docker.example。
DATABASE_URL="mysql://qzblog:change-me@localhost:3306/qzblog"
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_DATABASE="qzblog"
# MYSQL_USER="qzblog"
# MYSQL_PASSWORD="change-me"

# Canonical public origin, without a trailing slash.
SITE_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-at-least-32-random-bytes"

# GitHub OAuth is reserved/disabled in the frontend until explicitly enabled.
# ENABLE_GITHUB_AUTH="false"
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Existing administrator login only; registration is not supported.
ADMIN_USERNAME="admin"
# Prefer ADMIN_PASSWORD_HASH when supported by the deployed auth configuration.
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Set true only when a trusted reverse proxy overwrites X-Real-IP/X-Forwarded-For.
AUTH_TRUST_PROXY="false"

# Client identity/privacy
# REQUIRED in production (32+ random characters). Used to HMAC anonymous like identifiers.
ANONYMOUS_ID_SECRET="replace-with-at-least-32-random-characters"

# Trusted reverse proxy header. Leave empty unless your proxy strips and overwrites it.
# Allowed: cf-connecting-ip, x-real-ip, x-forwarded-for
TRUSTED_PROXY_IP_HEADER=""
# Shared rate limiting is required in production.
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# S3/MinIO image storage. The application does not set public-read ACLs.
# Configure a read-only CDN or bucket policy for S3_PUBLIC_URL; keep write credentials private.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-least-privilege-access-key"
S3_SECRET_ACCESS_KEY="your-least-privilege-secret-key"
S3_BUCKET_NAME="qzblog"
S3_PUBLIC_URL="http://localhost:9000/qzblog"
S3_FORCE_PATH_STYLE="true"

# Attachment storage driver (PRD 11.3): "local" writes to ./uploads served via /api/files/*,
# "s3" uses the S3/MinIO config above. When unset: s3 if S3/MinIO is configured, else local.
# ATTACHMENTS_STORAGE="local"


# Optional public contact address. Never reuse the administrator login email.
PUBLIC_CONTACT_EMAIL=""

# Legacy MinIO variable names are also accepted for existing deployments. S3_* takes
# precedence when both forms are set. These aliases may be used instead of S3_*:
# MINIO_ENDPOINT="http://localhost:9000"
# MINIO_REGION="auto"
# MINIO_ACCESS_KEY_ID="your-least-privilege-access-key" # MINIO_ACCESS_KEY also accepted
# MINIO_SECRET_ACCESS_KEY="your-least-privilege-secret-key" # MINIO_SECRET_KEY also accepted
# MINIO_BUCKET_NAME="qzblog" # MINIO_BUCKET also accepted
# MINIO_PUBLIC_URL="http://localhost:9000/qzblog"
# MINIO_FORCE_PATH_STYLE="true"
